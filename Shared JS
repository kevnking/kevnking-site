/* kevnking.com — shared.js — scroll animations */
(function () {
  var selectors = [
    '.home-what-item',
    '.svc',
    '.blog-card',
    '.about-item',
    '.about-body-text',
    '.about-sidebar',
    '.about-family-text',
    '.about-family-photos',
    '.home-story-text',
    '.home-story-photos',
    '.home-cta-inner',
    '.sell-why',
    '.wwm-hero-inner',
    '.contact-hero-inner',
    '.contact-options',
    '.co',
    '.home-what-header'
  ];

  function init() {
    // Only hide elements once JS is confirmed running
    document.body.classList.add('js-ready');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          var el = entry.target;
          var delay = parseInt(el.dataset.delay || 0);
          setTimeout(function () {
            el.classList.add('is-visible');
          }, delay);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

    selectors.forEach(function (sel) {
      document.querySelectorAll(sel).forEach(function (el) {
        el.classList.add('scroll-reveal');
        observer.observe(el);
      });
    });

    // Stagger grid children
    ['.home-what-grid', '.blog-grid', '.about-family-photos', '.services', '.contact-options'].forEach(function (parent) {
      document.querySelectorAll(parent + ' > *').forEach(function (child, i) {
        child.dataset.delay = i * 90;
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
